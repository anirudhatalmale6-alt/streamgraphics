node_modules/
*.log
.DS_Store
public/uploads/
data/library.json
data/lowerthird.json
public/logos/*
!public/logos/README.txt
public/media/*
!public/media/README.txt

# vendor license signing key — never commit
.license-private-key.pem
data/license.json

# Installer build artifacts (large binaries - shipped via GitHub Releases / download host)
installer/build/
installer/node-*.exe
*.exe
# ...except the signed launcher. This one is SOURCE, not a build artifact: it is signed once
# by hand and then reused by every build (see installer/BUILD.md). Losing it would mean going
# back to shipping an unsigned launcher, which is what caused the antivirus trouble.
!installer/launcher-signed/*.exe
